{
  "name": "gohealth-own-your-data",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "goh": "bin/goh"
  },
  "description": "Own your health data with a local Google Health insights dashboard",
  "license": "MIT",
  "keywords": [
    "google-health",
    "fitbit",
    "grafana",
    "health-data",
    "self-hosted"
  ],
  "scripts": {
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "build": "tsc",
    "health": "node --import tsx src/cli.ts",
    "start": "node --import tsx src/server.ts",
    "auth": "node --import tsx src/server.ts",
    "dashboard": "pnpm run health start",
    "dashboard:import": "node --max-old-space-size=1024 --import tsx src/dashboard-import.ts",
    "dashboard:stop": "pnpm run health stop",
    "export": "node --import tsx src/export-cli.ts",
    "refresh": "pnpm run health refresh 30",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "google-auth-library": "^10.9.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.9.1"
}
